LANGFUSE_SECRET_KEY= # [ echo "sk-lf-$(uuidgen)" ]
LANGFUSE_PUBLIC_KEY= # [ echo "pk-lf-$(uuidgen)" ]
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000 

# Langfuse Setup Credentials
# Bootstraps an account in Langfuse with the following credentials:
LANGFUSE_INIT_ORG_ID=agent-cube-org-id
LANGFUSE_INIT_ORG_NAME=Agent Cube Organization
LANGFUSE_INIT_PROJECT_ID= agent-cube-project-id
LANGFUSE_INIT_PROJECT_NAME=Agent Cube
LANGFUSE_INIT_PROJECT_PUBLIC_KEY= # [ Copy from LANGFUSE_PUBLIC_KEY ]
LANGFUSE_INIT_PROJECT_SECRET_KEY= # [ Copy from LANGFUSE_SECRET_KEY ]
LANGFUSE_INIT_USER_EMAIL=admin@example.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=123123123